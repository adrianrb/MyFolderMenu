#include <windows.h>
#include "@MFM_RESOURCES_DIR@/resource.h"

IDI_MYFOLDERMENU ICON "@MFM_RESOURCES_DIR@/app.ico"
1 RT_MANIFEST "@MFM_RESOURCES_DIR@/MyFolderMenu.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MFM_VERSION_COMMA@
 PRODUCTVERSION @MFM_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "adrian.barbosa@gmail.com"
            VALUE "FileDescription", "MyFolderMenu"
            VALUE "FileVersion", "@MFM_VERSION@"
            VALUE "InternalName", "MyFolderMenu"
            VALUE "LegalCopyright", "(2026) Copyleft by adrian.barbosa@gmail.com"
            VALUE "OriginalFilename", "MyFolderMenu.exe"
            VALUE "ProductName", "MyFolderMenu"
            VALUE "ProductVersion", "@MFM_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
